{
  "name": "mcp-mimicus",
  "version": "0.2.0",
  "description": "Mimicus — live federated visual design browser for agents",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "mimicus": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "cheerio": "1.2.0",
    "ipaddr.js": "2.5.0",
    "playwright": "1.64.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "7.0.2"
  }
}
