{
  "name": "mcp-mimicus",
  "version": "1.0.0",
  "description": "Mimicus — live federated visual design browser for agents",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "mimicus": "dist/cli.js"
  },
  "files": [
    "dist",
    "assets/mimicus-banner.svg",
    "assets/mimicus-banner.png",
    "docs/DEFAULT_BROWSER_BACKEND.md",
    "docs/SOURCE_INTEGRATION_MATRIX.md",
    "docs/AWWWARDS_INTEGRATION.md",
    "docs/STABILITY_AUDIT.md",
    "docs/FINAL_ENGINEERING_AUDIT.md",
    "docs/VISUAL_WORKFLOW_EVALUATION.md",
    "docs/QUALITY_AND_SECURITY_TEST_RESULTS.md",
    "docs/FINAL_LIMITATIONS.md",
    "docs/CONFIGURATION.md",
    "docs/SECURITY.md",
    "docs/MIGRATION.md",
    "docs/FINAL_PRODUCT_HARDENING_AUDIT.md",
    "docs/RETRIEVAL_EVALUATION.md",
    "docs/VISUAL_DISCOVERY_EVALUATION.md",
    "docs/BROWSER_RELIABILITY.md",
    "docs/AGENT_QUALITY_EVALUATION.md",
    "docs/INSTALLATION_AND_RELEASE.md",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc",
    "start": "node dist/cli.js",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "check": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "test:sources": "node scripts/source-release-acceptance.mjs",
    "banner": "node scripts/render-banner.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "cheerio": "1.2.0",
    "ipaddr.js": "2.5.0",
    "playwright": "1.64.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.10.1",
    "typescript": "7.0.2"
  }
}
